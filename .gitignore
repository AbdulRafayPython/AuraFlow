# ==========================================
# AuraFlow Root .gitignore
# Covers Backend/ Frontend/ and docs/
# ==========================================

# ---------- OS junk ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- IDE / Editor ----------
.idea/
*.swp
*.swo
*~

# ---------- Claude Code / AI assistant artifacts ----------
.claude/
CLAUDE.md

# ---------- VS Code (keep mcp.json out too — has API keys) ----------
.vscode/

# ---------- Docs (internal design docs, not for repo) ----------
docs/

# ---------- Test / scratch output ----------
Backend/test_out.txt
Backend/test_*.py
Backend/test_moderation.py

# ==========================================
# BACKEND (Python / Flask)
# ==========================================

# Virtual environment
Backend/venv/
Backend/.venv/
Backend/env/
Backend/ENV/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Environment variables
Backend/.env
Backend/.env.*

# Logs
Backend/*.log
Backend/startup.log

# Redis dump
Backend/dump.rdb

# Celery Beat schedule database
Backend/celerybeat-schedule.*

# Archive scripts with credentials
Backend/scripts/archive/setup_cloud_db.py

# Uploads (user-generated, not in repo)
Backend/uploads/

# ML models (too large for git)
Backend/models/

# Python packaging
*.egg-info/
*.egg
dist/
build/
*.whl

# Test / Coverage
htmlcov/
.coverage
.coverage.*
.pytest_cache/
.tox/
.nox/

# SQLite (if any)
*.db
*.sqlite3

# ==========================================
# FRONTEND (React / Vite / Node)
# ==========================================

# Dependencies
Frontend/node_modules/

# Build output
Frontend/dist/

# Environment variables
Frontend/.env
Frontend/.env.local
Frontend/.env.development
Frontend/.env.development.local
Frontend/.env.test.local
Frontend/.env.production.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Cache
.cache/
.next/
.nuxt/

# Local demo HTTPS certs (mkcert) — private keys, never commit
Frontend/certs/

# Runtime / build artifacts (never commit)
dump.rdb
*.rdb
*.tsbuildinfo
Backend/soak_24h_*.exit
*.exit

# Playwright MCP session snapshots / accessibility dumps (manual testing only)
.playwright-mcp/
/chat_mobile.yml
/create_modal.yml
/friends_mobile.yml

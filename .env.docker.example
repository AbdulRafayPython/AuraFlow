# Copy to `.env` (next to docker-compose.yml) and fill in the secrets.
# `.env` is git-ignored. Never commit real values.

# Generate each secret with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
JWT_SECRET_KEY=

# development: HTTP on localhost (default)
# production : forces an HTTPS redirect and HSTS, so only use it behind TLS
FLASK_ENV=development

# Load Backend/migrations/seed_data.sql (agent registry, platform settings AND
# demo accounts that share a known password) into an empty database.
# Set to false for any shared or public deployment.
SEED_DEMO_DATA=true

WEB_PORT=8080
